---
/*
 * GALLERY — dark grid of a wheel's photographs
 *   2 photos  → side by side
 *   3+ photos → the original asymmetric layout: the first spans both
 *               rows on the left, the rest stack on the right
 *
 * With fewer than 2 photos it renders nothing — the single photo is
 * already in the hero, so a one-image gallery would just repeat it.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
  caption: string;
}

const { images, caption } = Astro.props;
const layout = images.length === 2 ? 'pair' : 'feature';
---

{images.length >= 2 && (
  <section class="gallery" id="gallery">

    <div class="gallery__header">
      <span class="label" data-animate>The Wheel</span>
    </div>

    <div class:list={['gallery__grid', `gallery__grid--${layout}`]}>
      {images.map((image, i) => (
        <div class="gallery__item" data-animate data-delay={i * 150}>
          <Image
            src={image.src}
            alt={image.alt}
            widths={[600, 1000, 1400]}
            sizes="(max-width: 768px) 100vw, 50vw"
          />
        </div>
      ))}
    </div>

    <p class="gallery__caption">{caption}</p>

  </section>
)}

<style>
  .gallery {
    background: var(--ink);
    padding-top: 80px;
  }

  .gallery__header {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 40px 36px;
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
  }

  .gallery__grid--pair {
    grid-auto-rows: 560px;
  }

  .gallery__grid--feature {
    grid-auto-rows: 380px;
  }

  /* First photo spans both rows, creating the tall portrait slot */
  .gallery__grid--feature .gallery__item:first-child {
    grid-row: span 2;
  }

  .gallery__item {
    overflow: hidden;
  }

  .gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    /* Very slight scale on hover — barely perceptible, just warm */
    transition: transform 600ms ease;
  }

  .gallery__item:hover img {
    transform: scale(1.02);
  }

  .gallery__caption {
    max-width: 1240px;
    margin: 0 auto;
    padding: 22px 40px 80px;
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 300;
    color: var(--stone);
    text-align: right;
    opacity: 0.7;
  }

  /* Mobile: single column */
  @media (max-width: 768px) {
    .gallery__grid,
    .gallery__grid--pair,
    .gallery__grid--feature {
      grid-template-columns: 1fr;
      grid-auto-rows: 260px;
    }

    .gallery__grid--feature .gallery__item:first-child {
      grid-row: auto;
      height: 420px;
    }
  }
</style>
