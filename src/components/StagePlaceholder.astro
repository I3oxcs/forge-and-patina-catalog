---
/*
 * TEMPORARY — stands in for real page content until later stages.
 * Deleted once every page has been built.
 *
 * It opens with a dark band (so the transparent header has something
 * to sit on) followed by enough parchment to scroll through.
 */
interface Props {
  label: string;
  title: string;
  stage: number;
}

const { label, title, stage } = Astro.props;
---

<section class="placeholder__band">
  <div class="placeholder__inner">
    <span class="label">{label}</span>
    <div class="rule"></div>
    <h1 class="placeholder__title">{title}</h1>
    <p class="placeholder__note">This page is built in stage {stage}.</p>
  </div>
</section>

<section class="placeholder__body">
  <div class="placeholder__inner">
    <span class="label" data-animate>Scroll test</span>
    <div class="rule" data-animate></div>
    <p data-animate>
      Scroll down. The header turns ink after 80px, and these lines fade
      up as they enter the screen.
    </p>
    <p data-animate data-delay="150">
      Nothing leaves until it is correct.
    </p>
  </div>
</section>

<style>
  .placeholder__band {
    background: var(--ink);
    min-height: 70vh;
    display: flex;
    align-items: center;
    padding: calc(var(--header-height) + 40px) 40px 80px;
  }

  .placeholder__body {
    min-height: 90vh;
    padding: 120px 40px;
  }

  .placeholder__inner {
    max-width: 1240px;
    width: 100%;
    margin: 0 auto;
  }

  .placeholder__title {
    font-family: var(--serif);
    font-size: clamp(48px, 6vw, 88px);
    font-weight: 300;
    line-height: 1.0;
    letter-spacing: 0.02em;
    color: var(--parchment);
    margin-bottom: 24px;
  }

  .placeholder__note {
    font-size: 14px;
    color: var(--stone);
  }

  .placeholder__body p {
    max-width: 620px;
    margin-bottom: 22px;
  }

  .placeholder__body p:last-child {
    font-family: var(--serif);
    font-size: 22px;
    font-style: italic;
    color: var(--stone);
  }
</style>
