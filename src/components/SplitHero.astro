---
/*
 * SPLIT HERO — 45/55 split layout
 * Left panel: dark ink, text. Right panel: a photograph (or, if the
 * wheel has none yet, a placeholder in the wheel's finish).
 * Using a CSS Grid split preserves a portrait image's composition
 * at all viewport widths.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';
import WheelPlaceholder from './WheelPlaceholder.astro';
import type { SwatchKey } from '../data/swatches';

interface Props {
  title: string | string[];                     // "The Halden 71", or lines: ["Forge &", "Patina"]
  tagline: string[];                            // one entry per line
  label?: string;                               // small brand mark above
  cta: { href: string; text: string };
  image?: { src: ImageMetadata; alt: string };
  placeholderSwatch: SwatchKey;                 // used only when there's no image
}

const {
  title,
  tagline,
  label = 'Forge & Patina',
  cta,
  image,
  placeholderSwatch,
} = Astro.props;

// Lines passed in are used as they are. A single string is split after
// its first word: "The Halden 71" → ["The", "Halden 71"], like the original.
function toLines(text: string) {
  const firstSpace = text.indexOf(' ');
  return firstSpace === -1 ? [text] : [text.slice(0, firstSpace), text.slice(firstSpace + 1)];
}
const titleLines = Array.isArray(title) ? title : toLines(title);
---

<section class="hero">

  <div class="hero__text">

    <!-- Brand mark — anchored to top of panel, above centred content -->
    <span class="label hero__brand" data-hero="label">{label}</span>

    <!-- Vertically centred product block -->
    <div class="hero__content">
      <h1 class="hero__title" data-hero="title">
        {titleLines.map((line, i) => <>{i > 0 && <br />}{line}</>)}
      </h1>
      <p class="hero__tagline" data-hero="tagline">
        {tagline.map((line, i) => <>{i > 0 && <br />}{line}</>)}
      </p>
      <div class="hero__rule" data-hero="rule"></div>
      <!-- Wrapped in a div so this component's [data-hero] styles reach it -->
      <div data-hero="btn">
        <Button href={cta.href}>{cta.text}</Button>
      </div>
    </div>

  </div>

  <!-- `priority` on the photo: it's above the fold, so load it first, not lazily -->
  <div class="hero__image">
    {image ? (
      <Image
        src={image.src}
        alt={image.alt}
        widths={[800, 1200, 1600]}
        sizes="(max-width: 768px) 100vw, 55vw"
        priority
      />
    ) : (
      <WheelPlaceholder swatch={placeholderSwatch} />
    )}
  </div>

</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 45fr 55fr;
    min-height: 100vh;
  }

  /* LEFT: dark text panel */
  .hero__text {
    background: var(--ink);
    position: relative;          /* needed for absolutely-positioned brand label */
    display: flex;
    align-items: center;
    padding: 100px 64px 80px;
  }

  /* Brand name anchored to the top of the panel, above the centred content */
  .hero__brand {
    position: absolute;
    top: 104px;   /* 64px header + 40px breathing room */
    left: 64px;
  }

  /* The product name, tagline, rule, and button — vertically centred */
  .hero__content {
    width: 100%;
  }

  .hero__title {
    font-family: var(--serif);
    font-size: clamp(56px, 6.5vw, 96px);
    font-weight: 300;
    line-height: 1.0;
    letter-spacing: 0.02em;
    color: var(--parchment);
    margin-bottom: 28px;
  }

  .hero__tagline {
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.9;
    color: var(--stone);
  }

  .hero__rule {
    width: 40px;
    height: 1px;
    background: var(--bronze);
    margin: 28px 0 36px;
  }

  /* RIGHT: the image fills the panel */
  .hero__image {
    overflow: hidden;
    background: var(--ink);
  }

  .hero__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }


  /* ============================================================
     HERO ENTRANCE ANIMATION
     These fire on page load via the script below. The title also
     has a vertical offset; other hero elements just fade.
  ============================================================ */
  [data-hero] {
    opacity: 0;
    transition: opacity 900ms ease, transform 900ms ease;
  }

  [data-hero="title"] {
    transform: translateY(24px);  /* slides up as it fades in */
  }

  [data-hero].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-hero] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }


  /* Mobile: image stacks above text */
  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .hero__image {
      height: 50vh;
      order: -1;      /* image first on mobile */
    }

    .hero__text {
      padding: 56px 32px 72px;
    }

    .hero__brand {
      top: 28px;
      left: 32px;
    }
  }
</style>

<script>
  // ─────────────────────────────────────────────────────────────
  // HERO ENTRANCE ANIMATION
  //
  // When the page loads, hero text elements appear one by one.
  // Each has a data-hero attribute; we add .is-visible to each
  // after a fixed delay, creating a staggered sequence.
  // ─────────────────────────────────────────────────────────────

  const heroSequence = [
    { selector: '[data-hero="label"]',   delay: 400  },
    { selector: '[data-hero="title"]',   delay: 750  },
    { selector: '[data-hero="tagline"]', delay: 1100 },
    { selector: '[data-hero="rule"]',    delay: 1350 },
    { selector: '[data-hero="btn"]',     delay: 1500 },
  ];

  // 'load' waits for images and fonts, so nothing animates before
  // it has finished arriving.
  window.addEventListener('load', () => {
    heroSequence.forEach(({ selector, delay }) => {
      const el = document.querySelector(selector);
      if (!el) return;
      setTimeout(() => el.classList.add('is-visible'), delay);
    });
  });
</script>
